---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageIntro from '../components/PageIntro.astro'
const sections = [
  ['Хто ми', 'Тут буде погоджена інформація про волонтерський проєкт і команду.'],
  [
    'Наша мета',
    'Створити зрозумілий простір підтримки ветеранів і їхніх близьких. Формулювання місії буде погоджено командою.',
  ],
  [
    'Як ми працюємо',
    'Майбутній підхід: уважне ставлення, добровільність участі, повага до приватності та зрозуміла комунікація.',
  ],
  ['Напрями роботи', 'Психологічне відновлення, освіта, спільнота та інформаційна підтримка — заплановані напрями.'],
  ['Волонтери', 'Представлення волонтерів з’явиться після погодження та отримання їхньої згоди.'],
  ['Проєкти', 'Описи підтверджених ініціатив буде додано пізніше.'],
  ['Партнери', 'Організації та логотипи партнерів буде опубліковано лише після погодження.'],
]
---

<DefaultLayout title="Про нас" description="Підтримка, що починається з поваги до людини."
  ><PageIntro title="Про нас" description="Підтримка, що починається з поваги до людини." /><div
    class="shell section reading"
  >
    <p class="notice">Попередній зміст: тексти та фактичні відомості ще потребують погодження командою.</p>{
      sections.map(([heading, text]) => (
        <section class="text-section">
          <>
            <h2>{heading}</h2>
            <p>{text}</p>
          </>
        </section>
      ))
    }
  </div></DefaultLayout
>
