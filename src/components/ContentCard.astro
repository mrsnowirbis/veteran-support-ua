---
import { localMedia } from '../utils/content'
interface Props {
  title: string
  description: string
  href?: string
  category?: string
  meta?: string
  demo?: boolean
  index?: number
  image?: string
}
const { title, description, href, category, meta, demo = true, index = 0, image } = Astro.props
---

<article class="content-card">
  {localMedia(image) ? <img class="cover" src={image} alt="" loading="lazy" decoding="async" /> : <div class:list={['card-art', 'art-' + (index % 3)]} aria-hidden="true">
    <span>{String(index + 1).padStart(2, '0')}</span><i></i>
  </div>}
  <div class="card-copy">
    <div class="card-meta">{category && <span>{category}</span>}{demo && <span class="demo-tag">Демо</span>}</div><h3>
      {
        href ? (
          <a href={href}>
            {title}
            <span class="card-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ) : (
          title
        )
      }
    </h3><p>{description}</p>{meta && <p class="card-date">{meta}</p>}
  </div>
</article>
<style>.cover { width: 100%; height: 12rem; object-fit: cover; }</style>
