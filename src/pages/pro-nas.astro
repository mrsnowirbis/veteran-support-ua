---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageIntro from '../components/PageIntro.astro'
const sections = [
  ['Хто ми', 'Тут буде погоджена інформація про волонтерський проєкт і команду.'],
  [
    'Наша мета',
    'Створити зрозумілий простір підтримки ветеранів і їхніх близьких. Формулювання місії буде погоджено командою.',
  ],
  [
    'Як ми працюємо',
    'Майбутній підхід: уважне ставлення, добровільність участі, повага до приватності та зрозуміла комунікація.',
  ],
  ['Напрями роботи', 'Психологічне відновлення, освіта, спільнота та інформаційна підтримка — заплановані напрями.'],
  ['Волонтери', 'Представлення волонтерів з’явиться після погодження та отримання їхньої згоди.'],
  ['Проєкти', 'Описи підтверджених ініціатив буде додано пізніше.'],
  ['Партнери', 'Організації та логотипи партнерів буде опубліковано лише після погодження.'],
]
---

<DefaultLayout title="Про нас" description="Підтримка, що починається з поваги до людини.">
  <div class="about-chapter">
    <PageIntro title="Про нас" description="Підтримка, що починається з поваги до людини." />
    <div class="shell section reading">
      <p class="notice">Попередній зміст: тексти та фактичні відомості ще потребують погодження командою.</p>{
        sections.map(([heading, text]) => (
          <section class="text-section">
            <>
              <h2>{heading}</h2>
              <p>{text}</p>
            </>
          </section>
        ))
      }
    </div>
  </div>
</DefaultLayout>

<style>
  /* Local experiment: pigment stays in the margins of a clean reading column. */
  .about-chapter {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--background-color);
  }

  .about-chapter::before,
  .about-chapter::after {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    width: clamp(1rem, calc(50% - 442px), 18rem);
    background-repeat: no-repeat;
    pointer-events: none;
    content: '';
  }

  .about-chapter::before {
    inset-inline-start: 0;
    background-image:
      radial-gradient(ellipse at 32% 42%, color-mix(in srgb, var(--blue) 14%, transparent) 12%, transparent 69%),
      radial-gradient(ellipse at 34% 52%, color-mix(in srgb, var(--blue) 8%, transparent) 18%, transparent 72%),
      radial-gradient(ellipse at 12% 45%, color-mix(in srgb, var(--gold-line) 14%, transparent) 15%, transparent 70%),
      radial-gradient(ellipse at 26% 55%, color-mix(in srgb, var(--blue) 9%, transparent) 16%, transparent 72%);
    background-position: left -2rem top 2rem, left -1rem top 11rem, left -2rem top 39rem, left -2rem top 64rem;
    background-size: 115% 18rem, 85% 12rem, 110% 12rem, 100% 22rem;
  }

  .about-chapter::after {
    inset-inline-end: 0;
    background-image:
      radial-gradient(ellipse at 70% 40%, color-mix(in srgb, var(--gold-line) 18%, transparent) 14%, transparent 70%),
      radial-gradient(ellipse at 76% 58%, color-mix(in srgb, var(--blue) 10%, transparent) 16%, transparent 68%),
      radial-gradient(ellipse at 82% 45%, color-mix(in srgb, var(--gold-line) 12%, transparent) 12%, transparent 74%);
    background-position: right -2rem top 1rem, right -2rem top 15rem, right -2rem top 53rem;
    background-size: 115% 18rem, 100% 16rem, 110% 25rem;
  }

  .about-chapter :global(.page-intro) {
    background: transparent;
  }

  .about-chapter :global(.page-intro .shell) {
    max-width: 820px;
  }

  .about-chapter :global(.page-intro h1) {
    position: relative;
  }

  .about-chapter :global(.page-intro h1)::after {
    position: absolute;
    inset-block-end: -0.25rem;
    inset-inline-start: 0;
    border-radius: 60% 30% 50% 40%;
    background: linear-gradient(90deg, var(--gold-line), color-mix(in srgb, var(--gold-line) 30%, transparent));
    width: 4.5rem;
    height: 3px;
    pointer-events: none;
    content: '';
  }

  @media (max-width: 900px) {
    .about-chapter::before {
      display: none;
    }

    .about-chapter::after {
      /* A small corner wash leaves the narrow reading area completely clear. */
      inset-block-start: 0.5rem;
      inset-block-end: auto;
      width: 5rem;
      height: 5rem;
      background-image: radial-gradient(ellipse at 70% 40%, color-mix(in srgb, var(--gold-line) 12%, transparent) 14%, transparent 70%);
      background-position: right center;
      background-size: 100% 100%;
    }
  }
</style>
