---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import ContentCard from '../components/ContentCard.astro'
import SupportCTA from '../components/SupportCTA.astro'
import SupportIcon from '../components/SupportIcon.astro'
import HeroArtwork from '../components/HeroArtwork.astro'
import '../styles/approved-home.css'
import { loadContent, dateLabel, splitEvents } from '../utils/content'
import { youtubeThumbnail } from '../utils/youtube'
const { recovery, stories, events } = await loadContent()
const homeRecovery = recovery.slice(0, 3)
const hasYouTubeThumbnails = homeRecovery.some((e) => !e.data.image && Boolean(youtubeThumbnail(e.data.video ?? '')))
  || stories.some((e) => !e.data.image && Boolean(youtubeThumbnail(e.data.videos[0]?.url ?? '')))
const directions = [
 { icon: 'heart', title: 'Психологічна допомога', description: 'Психологічна, медико-психологічна реабілітація.', href: '/otrymaty-dopomohu' },
 { icon: 'plant', title: 'Відновлення', description: 'Реабілітація, адаптація та повернення до активного життя', href: '/vidnovlennia' },
 { icon: 'people', title: 'Історії сильних', description: 'Реальні люди.\nРеальні історії.\nРеальні зміни.', href: '/istorii' },
 { icon: 'education', title: 'Освіта та можливості', description: 'Знання, навички, нові можливості після служби', href: '/osvita' },
] as const
---

<DefaultLayout
  title="Підтримка ветеранів — поруч на шляху відновлення"
  description="Простір підтримки ветеранів та їхніх близьких: відновлення, освіта, історії й спільнота."
  useTitleTemplate={false}
  allowYouTubeThumbnails={hasYouTubeThumbnails}
>
  <section class="approved-hero" aria-labelledby="hero-title">
    <HeroArtwork />
    <div class="shell approved-hero-content">
      <div class="approved-hero-copy">
        <h1 id="hero-title"><span>ЧАС ПРАЦЮЄ</span><span>НА ТИХ,</span><span class="hero-gold">ХТО НЕ ЗДАЄТЬСЯ</span></h1>
        <p class="approved-subtitle">Допомога ветеранам, військовим, підтримка<br class="desktop-break" /> їхніх родин, реабілітація, освіта та повернення<br class="desktop-break" /> до повноцінного життя.</p>
        <div class="actions"><a class="button" href="/otrymaty-dopomohu"><span aria-hidden="true">♥</span> Отримати допомогу <span aria-hidden="true">→</span></a><a class="button button-outline" href="/pro-nas">Дізнатися більше</a></div>
      </div>
    </div>
  </section>
  <section class="shell hero-services" aria-label="Напрями підтримки">
    <h2 class="sr-only">Напрями підтримки</h2>
    {directions.map(item => <a class="hero-service" href={item.href}><SupportIcon name={item.icon} /><div><h3>{item.title}</h3><p>{item.description}</p></div><span class="service-arrow" aria-hidden="true">→</span></a>)}
  </section>
  <section class="shell mission" aria-labelledby="mission-title">
    <h2 id="mission-title">Наша мета</h2>
    <p>Підтримувати військових, учасників бойових дій та членів їх родин на всіх етапах відновлення — від лікування до повернення у суспільство.</p>
    <ul class="mission-directions"><li><SupportIcon name="people"/><span>Підтримка родин</span></li><li><SupportIcon name="plant"/><span>Реабілітація<br/>та адаптація</span></li><li><SupportIcon name="book"/><span>Освіта<br/>та розвиток</span></li></ul>
  </section>
  <section class="section section-tint">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Знання, які можуть стати опорою</p><h2>Матеріали для відновлення</h2></div><a
          class="text-link"
          href="/vidnovlennia">Усі матеріали →</a>
      </div><p class="demo-note">Практичні матеріали та перевірені ресурси для підтримки й відновлення.</p><div
        class="card-grid"
      >
        {
          homeRecovery
            .map((e, index) => (
              <ContentCard
                title={e.data.title}
                description={e.data.description}
                category={e.data.category}
                href={'/vidnovlennia/' + e.data.slug}
                image={e.data.image}
                youtubeUrl={e.data.video}
                compactMedia={true}
                demo={e.data.demo}
                index={index}
              />
            ))
        }
      </div>
    </div>
  </section>
  <section class="section shell">
    <div class="section-heading">
      <div><p class="eyebrow">Кожен шлях має значення</p><h2>Шлях відновлення</h2></div><a
        class="text-link"
        href="/istorii">Усі історії →</a>
    </div><p class="demo-note">Історії людей, які проходять власний шлях відновлення та повернення до активного життя.</p><div class="card-grid">
      {
        stories.map((e, index) => (
          <ContentCard
            title={e.data.title}
            description={e.data.excerpt}
            href={'/istorii/' + e.data.slug}
            image={e.data.image}
            youtubeUrl={e.data.videos[0]?.url}
            compactMedia={true}
            category="Історія відновлення"
            demo={e.data.demo}
            index={index}
          />
        ))
      }
    </div>
  </section>
  <section class="section shell events-home">
    <div class="section-heading">
      <div><p class="eyebrow">Разом — ближче</p><h2>Найближчі події</h2></div><a class="text-link" href="/podii"
        >Календар подій →</a>
    </div>{
      splitEvents(events)
        .upcoming.slice(0, 2)
        .map((e) => (
          <article class="event-row">
            <>
              <span class="event-date">{dateLabel(e.data.date)}</span>
              <div>
                <>
                  {e.data.demo && <span class="demo-tag">Демонстраційна подія</span>}
                  <h3>{e.data.title}</h3>
                  <p>{e.data.location}</p>
                </>
              </div>
              <a class="text-link" href={'/podii#' + e.id}>
                Про подію <span class="sr-only">{e.data.title}</span> →
              </a>
            </>
          </article>
        ))
    }{!splitEvents(events).upcoming.length && <p>Нові події буде додано після погодження.</p>}
  </section>
  <SupportCTA />
</DefaultLayout>
