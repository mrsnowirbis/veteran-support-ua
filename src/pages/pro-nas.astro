---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageIntro from '../components/PageIntro.astro'
const sections = [
  ['Хто ми', 'Тут буде погоджена інформація про волонтерський проєкт і команду.'],
  [
    'Наша мета',
    'Створити зрозумілий простір підтримки ветеранів і їхніх близьких. Формулювання місії буде погоджено командою.',
  ],
  [
    'Як ми працюємо',
    'Майбутній підхід: уважне ставлення, добровільність участі, повага до приватності та зрозуміла комунікація.',
  ],
  ['Напрями роботи', 'Психологічне відновлення, освіта, спільнота та інформаційна підтримка — заплановані напрями.'],
  ['Волонтери', 'Представлення волонтерів з’явиться після погодження та отримання їхньої згоди.'],
  ['Проєкти', 'Описи підтверджених ініціатив буде додано пізніше.'],
  ['Партнери', 'Організації та логотипи партнерів буде опубліковано лише після погодження.'],
]
---

<DefaultLayout title="Про нас" description="Підтримка, що починається з поваги до людини.">
  <div class="about-chapter">
    <div class="about-hero">
      <PageIntro title="Про нас" description="Підтримка, що починається з поваги до людини." />
      <picture class="about-art">
        <source
          media="(max-width: 900px)"
          srcset="/images/about-roots-support-mobile.webp"
          type="image/webp"
          width="780"
          height="571"
        />
        <img src="/images/about-roots-support.webp" width="1600" height="640" alt="" aria-hidden="true" decoding="async" />
      </picture>
    </div>
    <div class="shell section reading">
      <p class="notice">Попередній зміст: тексти та фактичні відомості ще потребують погодження командою.</p>{
        sections.map(([heading, text]) => (
          <section class="text-section">
            <>
              <h2>{heading}</h2>
              <p>{text}</p>
            </>
          </section>
        ))
      }
    </div>
  </div>
</DefaultLayout>

<style>
  .about-chapter {
    background: var(--background-color);
  }

  .about-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(380px, 40vw, 720px);
  }

  .about-hero :global(.page-intro) {
    background: transparent;
  }

  .about-hero :global(.page-intro .lead) {
    max-width: min(36%, 28rem);
  }

  .about-art {
    position: absolute;
    z-index: -1;
    inset: 0;
    display: block;
    pointer-events: none;
    /* Keep the copy on milk paper and dissolve the lower edge into the chapter. */
    mask-image: linear-gradient(90deg, transparent 36%, black 56%), linear-gradient(black 80%, transparent);
    mask-composite: intersect;
  }

  .about-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
  }

  @media (max-width: 900px) {
    .about-hero {
      min-height: 0;
    }

    .about-hero :global(.page-intro) {
      padding-block-end: 24px;
    }

    .about-hero :global(.page-intro .lead) {
      max-width: 57ch;
    }

    .about-art {
      position: relative;
      inset: auto;
      aspect-ratio: 780 / 571;
      mask-image: linear-gradient(transparent, black 14%, black 82%, transparent);
    }

    .about-art img {
      height: auto;
    }
  }
</style>
