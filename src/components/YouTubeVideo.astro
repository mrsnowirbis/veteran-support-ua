---
import { youtubeId } from '../utils/youtube'
interface Props { url: string; title: string }
const { url, title } = Astro.props
const id = youtubeId(url)
---
{id && <div class="youtube-video">
  <div class="video-frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}`}
      title={title}
      width="640" height="360"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  <p><a href={`https://www.youtube.com/watch?v=${id}`} rel="noopener noreferrer">Переглянути на YouTube — {title}</a></p>
</div>}
<style>
  .youtube-video { display: block; }
  .video-frame { display: grid; width: 100%; min-width: 0; aspect-ratio: 16 / 9; background: var(--soft); border: 1px solid var(--line); border-radius: 1rem; overflow: hidden; }
  iframe { display: block; width: 100%; min-width: 0; height: 100%; border: 0; }
</style>
