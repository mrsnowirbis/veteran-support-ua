---
import sanitizeHtml from 'sanitize-html'
import { localMedia } from '../utils/content'
const html = await Astro.slots.render('default')
const safeLink = (href = '') => localMedia(href) || /^https:\/\/[^\s\\]+$/i.test(href) || /^#[\w-]+$/.test(href)
const clean = sanitizeHtml(html, {
  allowedTags: ['p', 'br', 'hr', 'h2', 'h3', 'h4', 'h5', 'h6', 'strong', 'em', 's', 'blockquote', 'ul', 'ol', 'li', 'a', 'img', 'pre', 'code', 'table', 'thead', 'tbody', 'tr', 'th', 'td'],
  allowedAttributes: { a: ['href', 'rel', 'title'], img: ['src', 'alt', 'title', 'loading', 'decoding'], ol: ['start'] },
  allowedSchemes: ['https'],
  allowProtocolRelative: false,
  transformTags: {
    h1: 'h2',
    a: (_tag, attrs) => ({ tagName: 'a', attribs: { ...attrs, href: safeLink(attrs.href) ? attrs.href : '', rel: 'noopener noreferrer' } }),
    img: (_tag, attrs) => ({ tagName: 'img', attribs: { ...attrs, alt: attrs.alt || '', loading: 'lazy', decoding: 'async' } }),
  },
  exclusiveFilter: (frame) => frame.tag === 'img' && !localMedia(frame.attribs.src),
})
---
<div class="article-body" set:html={clean} />
<style>
  .article-body { overflow-wrap: anywhere; }
  .article-body :global(img) { max-width: 100%; height: auto; border-radius: 1rem; }
  .article-body :global(pre), .article-body :global(table) { max-width: 100%; overflow-x: auto; display: block; }
</style>
