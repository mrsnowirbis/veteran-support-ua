---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import Publication from '../../components/Publication.astro'
import { visibleContent } from '../../utils/content'
export async function getStaticPaths() {
  const entries = await getCollection('stories', visibleContent)
  const paths = entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))
  if (new Set(paths.map((path) => path.params.slug)).size !== paths.length) throw new Error('Duplicate stories URLs')
  return paths
}
interface Props { entry: CollectionEntry<'stories'> }
---
<Publication entry={Astro.props.entry} />
