---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageIntro from '../components/PageIntro.astro'
const sections = [
  [
    'Статус документа',
    'Це placeholder, а не затверджена політика конфіденційності. Власника сайту, контакти відповідальної особи та застосовні правила ще потрібно визначити.',
  ],
  [
    'Що працює зараз',
    'Аналітика та робоча форма звернень не підключені. Дані з макета форми не надсилаються. Умови журналювання майбутнього хостингу потребують окремої перевірки.',
  ],
  [
    'Що необхідно погодити',
    'Мета й підстави обробки, одержувачі даних, строки зберігання, права людей, порядок звернення та видалення даних.',
  ],
]
---

<DefaultLayout
  title="Політика конфіденційності"
  description="Чернетка структури документа. Перед production потрібна юридична перевірка."
  ><PageIntro
    title="Політика конфіденційності"
    description="Чернетка структури документа. Перед production потрібна юридична перевірка."
  /><div class="shell section reading">
    <p class="notice">Юридична чернетка. Перед публікацією потрібні перевірка й погодження.</p>{
      sections.map(([heading, text]) => (
        <section class="text-section">
          <>
            <h2>{heading}</h2>
            <p>{text}</p>
          </>
        </section>
      ))
    }
  </div></DefaultLayout
>
