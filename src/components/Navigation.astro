---
import Logo from './Logo.astro'
const items = [
  ['Головна', '/'],
  ['Про нас', '/pro-nas'],
  ['Відновлення', '/vidnovlennia'],
  ['Історії', '/istorii'],
  ['Кінотерапія', '/kinoterapiia'],
  ['Освіта', '/osvita'],
  ['Волонтерство', '/volonterstvo'],
  ['Контакти', '/kontakty'],
]
const current = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<div class="shell navigation">
  <Logo />
  <button class="responsive-toggle" aria-controls="mobile-navigation" aria-expanded="false" hidden
    >Меню <span aria-hidden="true">☰</span></button
  >
  <nav id="mobile-navigation" aria-label="Головна навігація">
    <ul>
      {
        items.map(([label, href]) => (
          <li>
            <a
              href={href}
              aria-current={current === href || (href !== '/' && current.startsWith(href + '/')) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="button button-small" href="/otrymaty-dopomohu">Отримати допомогу <span aria-hidden="true">→</span></a>
  </nav>
</div>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.responsive-toggle')
  const menu = document.querySelector<HTMLElement>('#mobile-navigation')
  if (toggle && menu) {
    toggle.hidden = false
    const wide = window.matchMedia('(min-width: 1350px)')
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false')
      menu.hidden = !wide.matches
    }
    close()
    wide.addEventListener('change', close)
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true'
      toggle.setAttribute('aria-expanded', String(!open))
      menu.hidden = open
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close()
        toggle.focus()
      }
    })
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a') && !wide.matches) close()
    })
  }
</script>
