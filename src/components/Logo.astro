---
import themeConfig from '@theme-config'
interface Props {
  loading?: 'eager' | 'lazy'
}
const { loading = 'eager' } = Astro.props
---

<a href="/" class="brand" aria-label="Підтримка ветеранів — головна">
  <img src="/brand/logo-original.jpg" width="1536" height="1536" alt="" loading={loading} decoding="async" />
  <span><strong>{themeConfig.name}</strong><small>Поруч на шляху відновлення</small></span>
</a>
