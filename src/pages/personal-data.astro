---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageIntro from '../components/PageIntro.astro'
const sections = [
  [
    'Мінімум необхідних даних',
    'Майбутня форма передбачає ім’я, спосіб зв’язку, контакт, місто або область, категорію допомоги та коротке повідомлення.',
  ],
  [
    'Чутливі відомості',
    'Не надсилайте діагнози, медичні документи та іншу чутливу медичну інформацію через публічний сайт.',
  ],
  [
    'До запуску звернень',
    'Потрібно визначити відповідального за дані, підстави обробки, строк видалення, доступ команди та порядок реалізації прав. Текст і згоду слід перевірити юридично.',
  ],
]
---

<DefaultLayout
  title="Обробка персональних даних"
  description="Попередня структура пояснення обробки даних. Не остаточний юридичний документ."
  ><PageIntro
    title="Обробка персональних даних"
    description="Попередня структура пояснення обробки даних. Не остаточний юридичний документ."
  /><div class="shell section reading">
    <p class="notice">Юридична чернетка. Перед публікацією потрібні перевірка й погодження.</p>{
      sections.map(([heading, text]) => (
        <section class="text-section">
          <>
            <h2>{heading}</h2>
            <p>{text}</p>
          </>
        </section>
      ))
    }
  </div></DefaultLayout
>
